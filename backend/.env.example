# Cổng backend lắng nghe
PORT=5001

# MongoDB (Docker Compose dùng mongodb://mongo:27017/komi)
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/komi

# Chuỗi bí mật ký access token — đặt chuỗi dài, ngẫu nhiên, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=doi-thanh-chuoi-bi-mat-cua-ban

# Origin của frontend (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Cloudinary — cần cho upload avatar và gửi ảnh trong chat.
# Chạy bằng docker compose thì điền vào file .env ở thư mục gốc (cạnh docker-compose.yml).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Đặt 1 khi chạy sau reverse proxy (Render, Railway, Nginx) để rate limit thấy IP thật
# TRUST_PROXY=1
