# Cổng backend lắng nghe
PORT=5001

# MongoDB Atlas Local (Docker Compose dùng mongodb://mongo:27017/komi?directConnection=true).
# Cần directConnection=true: container chạy replica set một node, thiếu thì driver đi tìm hostname của container.
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/komi?directConnection=true

# Chuỗi bí mật ký access token — đặt chuỗi dài, ngẫu nhiên, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=doi-thanh-chuoi-bi-mat-cua-ban

# Origin của frontend (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Cloudinary — cần cho upload avatar và gửi ảnh trong chat.
# Chạy bằng docker compose thì điền vào file .env ở thư mục gốc (cạnh docker-compose.yml).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Đặt 1 khi chạy sau reverse proxy (Render, Railway, Nginx) để rate limit thấy IP thật
# TRUST_PROXY=1

# Komi AI — mọi lời gọi LLM đi qua backend/src/ai/llm.js
#   LLM_PROVIDER để trống          → tắt AI
#   LLM_PROVIDER=fake               → trả lời cố định, không gọi mạng (test, demo không cần key)
#   LLM_PROVIDER=openai-compatible  → gọi API chuẩn OpenAI tại LLM_BASE_URL
# Chỉ dùng key free tier KHÔNG gắn thẻ. API key chỉ đặt ở backend, không bao giờ đưa vào VITE_*.
#   Gemini (Google AI Studio): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq (dự phòng):           LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL: tên model lấy từ danh sách model của nhà cung cấp (Gemini: dòng Flash / Flash-Lite).
# Chạy bằng docker compose thì điền vào file .env ở thư mục gốc.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Số lượt hỏi Komi AI mỗi user mỗi ngày (tính lại lúc 0h giờ Việt Nam). Để trống = 20.
AI_DAILY_LIMIT=

# Số tài liệu một user được tải lên kho tài liệu chung mỗi ngày (tính lại lúc 0h giờ Việt Nam). Để trống = 10.
SHARED_DOC_DAILY_LIMIT=

# Embedding cho tìm kiếm tài liệu (Giai đoạn 4) — mọi lời gọi đi qua backend/src/ai/embeddings.js
#   EMBEDDING_PROVIDER để trống          → tắt
#   EMBEDDING_PROVIDER=fake               → vector giả theo từ, không gọi mạng (test)
#   EMBEDDING_PROVIDER=openai-compatible  → gọi POST {base URL}/embeddings
# EMBEDDING_BASE_URL để trống thì dùng chung LLM_BASE_URL và LLM_API_KEY (một key Gemini cho cả hai).
# Đặt EMBEDDING_BASE_URL riêng thì phải đặt EMBEDDING_API_KEY (key của chat không được gửi đi).
#   Gemini: EMBEDDING_MODEL=gemini-embedding-2 (free tier: 100 đoạn/phút, tính theo từng đoạn trong batch)
# EMBEDDING_DIMENSIONS: số chiều vector, để trống = 768. Đổi số này thì phải tạo lại vector index và embedding.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Tìm kiếm vector: atlas (mặc định, $vectorSearch của Atlas / Atlas Local) hoặc memory (tính trong JS, chỉ cho test)
VECTOR_STORE=
